#!/usr/bin/env bash
# Git credential helper in front of the Windows GCM. It serialises `get`, so concurrent git
# processes raise one sign-in window, and logs every call, so an `erase` names its caller.
#
# install.sh sets it as credential.helper on WSL, where the GCM .exe exists.
# Log: ~/.local/state/git-credential-gcm-wsl.log — drops password, username and URL userinfo, not other secrets in argv.
set -u

gcm='/mnt/c/Program Files/Git/ucrt64/bin/git-credential-manager.exe'
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
log_file="$state_dir/git-credential-gcm-wsl.log"
lock_file="$state_dir/git-credential-gcm-wsl.lock"
mkdir -p "$state_dir"

action="${1:-}"
input="$(cat)"
fields="$(printf '%s\n' "$input" | grep -E '^(protocol|host|path)=' | tr '\n' ' ')"

callers() {
  local pid=$PPID chain='' cmd
  for _ in 1 2 3 4; do
    [ "${pid:-1}" -gt 1 ] || break
    cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | sed -E 's#://[^/ ]*@#://#g')"
    chain+=" <- [$pid] ${cmd% }"
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
  done
  printf '%s' "$chain"
}

log() {
  printf '%s %-5s pid=%s cwd=%s %s%s\n' "$(date '+%F %T')" "$action" "$$" "$PWD" "$fields" "$*" >> "$log_file"
}

if [ "$action" = get ]; then
  exec 9> "$lock_file"
  start=$SECONDS
  flock -w 600 9 || log "lock timeout after 600s, calling GCM anyway"
  waited=$((SECONDS - start))
  # The holder may have just signed in, so give its git time to `store` the new token.
  [ "$waited" -gt 1 ] && sleep 5
  output="$(printf '%s\n' "$input" | "$gcm" get)"
  status=$?
  case "$output" in *password=*) found=yes ;; *) found=no ;; esac
  log "waited=${waited}s status=$status password=$found$(callers)"
  [ -n "$output" ] && printf '%s\n' "$output"
  exit "$status"
fi

printf '%s\n' "$input" | "$gcm" "$@"
status=$?
log "status=$status$(callers)"
exit "$status"
