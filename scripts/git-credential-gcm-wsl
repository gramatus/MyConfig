#!/usr/bin/env bash
# Git credential helper in front of the Windows GCM. It serialises `get`, so concurrent git
# processes raise one sign-in window, retries a failed `get` once, and skips the `erase` git
# sends after that failure, which would otherwise delete a token that is still valid.
# Every call is logged, so an `erase` names its caller.
#
# install.sh sets it as credential.helper on WSL, where the GCM .exe exists.
# Log: ~/.local/state/git-credential-gcm-wsl.log — never holds a password or token.
set -u

gcm='/mnt/c/Program Files/Git/ucrt64/bin/git-credential-manager.exe'
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
log_file="$state_dir/git-credential-gcm-wsl.log"
lock_file="$state_dir/git-credential-gcm-wsl.lock"
mkdir -p "$state_dir"
find "$state_dir" -maxdepth 1 -name 'failed-get.*' -mmin +5 -delete 2>/dev/null

action="${1:-}"
input="$(cat)"
fields="$(printf '%s\n' "$input" | grep -E '^(protocol|host|path|username)=' | tr '\n' ' ')"

callers() {
  local pid=$PPID chain='' cmd
  for _ in 1 2 3 4; do
    [ "${pid:-1}" -gt 1 ] || break
    cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
    chain+=" <- [$pid] ${cmd% }"
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
  done
  printf '%s' "$chain"
}

# The git process behind the `sh -c` git wraps each helper call in, shared by its get and erase.
git_pid() {
  local pid=$PPID
  while [ "$(ps -o comm= -p "$pid" 2>/dev/null)" = sh ]; do
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
  done
  printf '%s' "$pid"
}

log() {
  printf '%s %-5s pid=%s cwd=%s %s%s\n' "$(date '+%F %T')" "$action" "$$" "$PWD" "$fields" "$*" >> "$log_file"
}

marker="$state_dir/failed-get.$(git_pid)"

if [ "$action" = get ]; then
  exec 9> "$lock_file"
  start=$SECONDS
  flock -w 600 9 || log "lock timeout after 600s, calling GCM anyway"
  waited=$((SECONDS - start))
  # The holder may have just signed in, so give its git time to `store` the new token.
  [ "$waited" -gt 1 ] && sleep 5
  err_file="$(mktemp "$state_dir/gcm-stderr.XXXXXX")"
  for attempt in 1 2; do
    output="$(printf '%s\n' "$input" | "$gcm" get 2> "$err_file")"
    status=$?
    case "$output" in *password=*) found=yes ;; *) found=no ;; esac
    err="$(head -n 1 "$err_file")"
    cat "$err_file" >&2
    log "attempt=$attempt waited=${waited}s status=$status password=$found${err:+ stderr=$err}$(callers)"
    [ "$found" = yes ] && break
    [ "$attempt" = 1 ] && sleep 3
  done
  rm -f "$err_file"
  if [ "$found" = yes ]; then rm -f "$marker"; else touch "$marker"; fi
  [ -n "$output" ] && printf '%s\n' "$output"
  exit "$status"
fi

if [ "$action" = erase ] && [ -e "$marker" ]; then
  rm -f "$marker"
  log "skipped: this git's get failed, so the stored token was never tried$(callers)"
  exit 0
fi

printf '%s\n' "$input" | "$gcm" "$@"
status=$?
log "status=$status$(callers)"
exit "$status"
