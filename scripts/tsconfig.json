// Editor diagnostics for the .mts scripts in this folder.
//
// Without this, VS Code falls back to an inferred project with no @types/node, so every
// `node:` import is "cannot find module" and `process` / `Buffer` are undefined names —
// hundreds of errors on a script that runs fine. Nothing compiles these files: `noEmit`
// is set and node strips the types at run time. This exists only so the editor is quiet
// and honest.
//
// `include` is deliberately non-recursive: scripts/ holds a `scripts -> .` self-symlink
// (gitignored, line 6 of .gitignore), and a `**/*` glob would descend it forever.
{
  "compilerOptions": {
    "noEmit": true,

    // es2023 target/lib to match the harness config and Node 22, which is the floor for
    // running these at all.
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // These scripts are run with bare `node`, which strips types rather than compiling
    // them: enum, namespace and parameter properties are refused outright, and an
    // unmarked type import survives into the emitted module and fails at run time.
    // Without this pair the checker accepts all four and only running the script finds
    // out. Same reasoning as .agent-harness/scripts/tsconfig.json.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    // Node resolves an import only by its real file name, so the tests import `.mts` paths.
    "allowImportingTsExtensions": true,

    "strict": true,

    "types": ["node"]
  },
  "include": ["*.mts", "*.mjs"]
}
