{
  "OWNED": "Owned by the agent harness, and overwritten on every link. Put repo-specific commands behind package.json scripts.",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "Grep",
      "Glob",
      "LS",
      "mcp__ide__getDiagnostics",
      "WebSearch",
      "WebFetch",
      "Skill(commit)",
      "Skill(pr-review:*)",
      "Skill(pr-summary:*)",
      "Skill(code)",
      "Skill(docs)",
      "Agent"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git difftool:*)",
      "Bash(npx:*)",
      "Bash(docker push:*)",
      "Bash(docker image push:*)",
      "Bash(docker manifest push:*)",
      "Bash(docker compose push:*)",
      "Bash(docker-compose push:*)",
      "Bash(node scripts/update-consumers.mts:*)",
      "Bash(dotnet restore:*)",
      "Bash(terraform init:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "Bash(for:*)",
      "Bash(sudo:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(netcat:*)",
      "Bash(xargs:*)",
      "Bash(eval:*)"
    ],
    "ask": []
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/fallback/skip-in-cursor.sh\" run.mjs"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/fallback/skip-in-cursor.sh\" run.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|execution_subagent|Agent|AskUserQuestion|Edit|Write|MultiEdit|create_file|replace_string_in_file|multi_replace_string_in_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/fallback/skip-in-cursor.sh\" guard.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/fallback/skip-in-cursor.sh\" run.mjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/fallback/skip-in-cursor.sh\" run.mjs"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/fallback/skip-in-cursor.sh\" run.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TodoWrite|Agent|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/fallback/skip-in-cursor.sh\" run.mjs"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/fallback/skip-in-cursor.sh\" run.mjs"
          }
        ]
      }
    ]
  },
  "autoUpdatesChannel": "stable"
}
