{
  "theme": "auto",
  "remoteControlAtStartup": false,
  "autoUpdatesChannel": "stable",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-askuserquestion.sh\""
          }
        ]
      }
    ]
  }
}
