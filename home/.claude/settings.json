{
  "disableClaudeAiConnectors": true,
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "extraKnownMarketplaces": {},
  "theme": "auto",
  "remoteControlAtStartup": false,
  "autoUpdatesChannel": "stable",
  "permissions": {
    "allow": [
      "Bash(git notes --ref=target show:*)",
      "Bash(git notes --ref=target list:*)",
      "Bash(git notes --ref target show:*)",
      "Bash(git notes --ref target list:*)"
    ],
    "additionalDirectories": ["/repos"]
  },
  "hooks": {
    "ConfigChange": [
      {
        "matcher": "skills",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/pause-skill-reload-on-rebase.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|vscode_askQuestions|ask_user",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/block-askuserquestion.sh\""
          }
        ]
      }
    ]
  }
}
